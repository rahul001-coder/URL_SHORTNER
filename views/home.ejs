<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortener</title>
</head>

<body>
    <h1>URL Shortener</h1>

    <% if (locals.id) { %>
        <p>Generated short ID: <a href="http://localhost:3001/url/<%= id %>">
                localhost:3001/url/<%= id %>
            </a>
        </p>
        <% } %>

            <div>
                <form method="POST" action="/url">
                    <label>Enter Original URL</label>
                    <input type="text" name="redirectURL" placeholder="http://example.com" required />
                    <button type="submit">Generate</button>
                </form>
            </div>


</body>

</html>